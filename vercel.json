{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/practice",
      "destination": "/healthportal",
      "permanent": false
    },
    {
      "source": "/learn.html",
      "destination": "/learn",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/healthportal",
      "destination": "https://tracingcare-demo.vercel.app/practice"
    },
    {
      "source": "/:path*",
      "destination": "https://tracingcare-demo.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
